# Copy to .env and fill in what you have. Everything is optional — with no
# values set, both integrations run fully in mock mode against realistic
# fixtures (see src/ecommerce_mcp/fixtures/).

# Global default. Per-integration flags below override this when set.
MOCK_MODE=true

# --- Shopify ---------------------------------------------------------------
# Force mock/live for Shopify specifically, overriding MOCK_MODE.
# SHOPIFY_MOCK=false
#
# From a Shopify Partners dev store: Settings -> Apps and sales channels ->
# Develop apps -> create a custom app -> Admin API access token.
# SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-10

# --- Meta Ads ----------------------------------------------------------------
# Force mock/live for Meta specifically, overriding MOCK_MODE.
# META_MOCK=false
#
# From Meta Business Suite -> System Users, or the Graph API Explorer for a
# short-lived token: ads_read permission on the ad account below.
# META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# META_AD_ACCOUNT_ID=act_1234567890
META_API_VERSION=v21.0
